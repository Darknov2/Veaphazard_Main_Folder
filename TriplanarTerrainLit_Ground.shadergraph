    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "02257bc936a24121b7a35408683ddca1",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "TriplanarSampleColor (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2378.0,
            "y": 1334.0,
            "width": 276.0,
            "height": 118.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "13fc044a04a84c539664080e0ba84d9f"
        },
        {
            "m_Id": "53ebb0bf7a5f4dceac8a5f62b70c0c30"
        },
        {
            "m_Id": "7d5f03f0fca144dd9d52a7ba880996c2"
        },
        {
            "m_Id": "5e4a09674b464f9dbaa45842616d9b08"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TriplanarSampleColor",
    "m_FunctionSource": "96de908384869cd409c75efa351d5edf",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// inputs: WorldNormal, Sharpness\r\n// output: OutWeights (float3)\r\n\r\nfloat3 n = abs(normalize(WorldNormal));\r\nn = pow(n, float3(Sharpness, Sharpness, Sharpness));\r\nfloat sum = n.x + n.y + n.z + 1e-6;\r\nOutWeights = n / sum;"
}

